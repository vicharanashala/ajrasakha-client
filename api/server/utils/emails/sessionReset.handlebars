<!DOCTYPE html>
<html
  xmlns='http://www.w3.org/1999/xhtml'
  xmlns:v='urn:schemas-microsoft-com:vml'
  xmlns:o='urn:schemas-microsoft-com:office:office'
>

  <head>
    <!--[if gte mso 9]>
<xml>
<o:OfficeDocumentSettings>
    <o:AllowPNG />
    <o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
<![endif]-->
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='x-apple-disable-message-reformatting' />
    <meta name='color-scheme' content='light' />
    <meta name='supported-color-schemes' content='light' />
    <title>Session Reset Request</title>
    <style type='text/css'>
      body {
        margin: 0;
        padding: 0;
        -webkit-text-size-adjust: 100%;
      }
      table,
      td {
        border-collapse: collapse;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
      }
      @media only screen and (max-width: 520px) {
        .card {
          width: 100% !important;
        }
        .card-body {
          padding: 28px 20px !important;
        }
      }
    </style>
  </head>

  <body style='margin:0;padding:0;background-color:#f4f7f5;'>
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#f4f7f5;'
    >
      <tr>
        <td align='center' style='padding:32px 12px;'>
          <table
            role='presentation'
            class='card'
            width='520'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='width:520px;max-width:100%;background-color:#ffffff;border:1px solid #e3ebe6;border-radius:8px;'
          >
            <tr>
              <td
                align='left'
                style='padding:24px 32px;border-bottom:3px solid #27b554;border-radius:8px 8px 0 0;'
              >
                <table role='presentation' cellpadding='0' cellspacing='0' border='0'>
                  <tr>
                    <td valign='middle' style='padding-right:10px;'>
                      <img
                        src='{{logoUrl}}'
                        width='40'
                        height='40'
                        alt='{{appName}}'
                        style='display:block;border:0;outline:none;width:40px;height:40px;'
                      />
                    </td>
                    <td
                      valign='middle'
                      style='font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:700;color:#1a2e22;'
                    >
                      AjraSakha
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                class='card-body'
                style='padding:32px;font-family:Arial,Helvetica,sans-serif;color:#33413a;font-size:15px;line-height:24px;'
              >
                <h1
                  style='margin:0 0 20px;font-size:22px;line-height:30px;font-weight:700;color:#1a2e22;'
                >
                  Session Reset Request
                </h1>
                <p style='margin:0 0 16px;color:#33413a;'>Dear {{name}},</p>
                <p style='margin:0 0 24px;color:#33413a;'>
                  We received a request to log out of your existing devices and sign in to your
                  {{appName}}
                  account on a new device. To terminate all active sessions and allow login, click
                  the button below.
                </p>
                <table role='presentation' cellpadding='0' cellspacing='0' border='0'>
                  <tr>
                    <td align='center' bgcolor='#1a8f3f' style='border-radius:6px;'>
                      <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{verificationLink}}" style="height:44px;v-text-anchor:middle;width:240px;" arcsize="14%" stroke="f" fillcolor="#1a8f3f"><w:anchorlock/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;"><![endif]-->
                      <a
                        href='{{verificationLink}}'
                        target='_blank'
                        style='display:inline-block;padding:12px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;line-height:20px;color:#ffffff;text-decoration:none;background-color:#1a8f3f;border-radius:6px;'
                      >
                        Terminate Other Sessions
                      </a>
                      <!--[if mso]></center></v:roundrect><![endif]-->
                    </td>
                  </tr>
                </table>
                <p style='margin:24px 0 0;font-size:13px;line-height:20px;color:#5d6d64;'>
                  This link is valid for 15 minutes. If you did not make this request, please ignore
                  this email and change your password immediately.
                </p>
              </td>
            </tr>
            <tr>
              <td
                style='padding:20px 32px;border-top:1px solid #e3ebe6;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7a8a81;'
              >
                Best regards,<br />The {{appName}} Team<br /><br />&copy; {{year}} {{appName}}. All
                rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>

</html>
